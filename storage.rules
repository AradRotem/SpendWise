rules_version = '2';

// SpendWise Step 18 Firebase Storage security rules.
//
// Schema: users/{uid}/receipts/{receiptId}/{fileName}
//
// Core rule: a signed-in user may only read/write receipt files under their own users/{uid} tree
// - mirrors firestore.rules's users/{uid} rule for the Firestore side of the same data. Nothing
// under Storage is shared across accounts.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/receipts/{receiptId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
