rules_version = '2';

// SpendWise Step 17 Firestore security rules.
//
// Schema (all per-user, under users/{uid}):
//   users/{uid}                                       - profile doc
//   users/{uid}/transactions/{syncId}
//   users/{uid}/categories/{syncId}
//   users/{uid}/budgets/{syncId}
//   users/{uid}/recurringPlans/{syncId}
//   users/{uid}/recurringOccurrenceExceptions/{syncId}
//   users/{uid}/groups/{syncId}
//   users/{uid}/groupMembers/{syncId}          (field: groupSyncId)
//   users/{uid}/groupExpenses/{syncId}         (field: groupSyncId)
//   users/{uid}/groupExpenseShares/{syncId}    (field: groupExpenseSyncId)
//
// Core rule: a signed-in user may only read/write documents under their own users/{uid} tree.
// Nothing here is shared across accounts yet - Step 17 explicitly does not implement real
// cross-account group membership (see the app's Step 17 scope notes); that is left for a later
// step, and this schema/ruleset does not block extending it then.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{collection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
